{
  "$schema": "https://openapi.vercel.com/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "buildCommand": "python scripts/vercel_build.py",
  "build": {
    "env": {
      "PARALLAX_RUN_EVENTS_ENABLED": "1",
      "PARALLAX_AGENTIC_RUNTIME_ENABLED": "1"
    }
  },
  "env": {
    "PARALLAX_RUN_EVENTS_ENABLED": "1",
    "PARALLAX_AGENTIC_RUNTIME_ENABLED": "1"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
