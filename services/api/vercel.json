{
  "$schema": "https://openapi.vercel.com/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "buildCommand": "python scripts/connect_build_probe.py",
  "rewrites": [
    {
      "source": "/__connect_probe",
      "destination": "/api/connect_probe.py"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
