PARALLAX_ENV=development
DATABASE_URL=sqlite:///./parallax.db
PARALLAX_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
PARALLAX_CORS_ORIGIN_REGEX=
PARALLAX_ACTIVE_SPEC_ID=P2-V0.13.0
PARALLAX_ACCESS_TOKEN=replace-with-a-random-value-of-at-least-32-characters
PARALLAX_CREATE_SCHEMA=false
PARALLAX_ALLOW_SCOPE_OVERRIDE=false
DSPY_MODEL=openai/gpt-5.6-sol
# Optional local-first routing. These are server-owned settings; callers cannot
# provide model endpoints or route order. When enabled, the local model is tried
# before the existing Luna -> Terra -> Sol hosted chain.
# For a co-located Ollama development server:
#   PARALLAX_LOCAL_MODEL_ENABLED=true
#   PARALLAX_LOCAL_MODEL=ollama_chat/llama3.2:1b
#   PARALLAX_LOCAL_MODEL_PROVIDER=ollama
#   PARALLAX_LOCAL_MODEL_API_BASE=http://127.0.0.1:11434
# If a local/private endpoint requires authentication, set the name of a separate
# server-side environment variable in PARALLAX_LOCAL_MODEL_API_KEY_ENV. Do not put
# a credential value in this setting.
PARALLAX_LOCAL_MODEL_ENABLED=false
PARALLAX_LOCAL_MODEL=
PARALLAX_LOCAL_MODEL_PROVIDER=
PARALLAX_LOCAL_MODEL_API_BASE=
PARALLAX_LOCAL_MODEL_API_KEY_ENV=
# Production Vercel Functions authenticate hosted model traffic with the validated
# request-scoped x-vercel-oidc-token supplied by Vercel. The server-owned hosted
# endpoint is https://ai-gateway.vercel.sh/v1; it is not caller configurable.
# Do not treat a process-environment VERCEL_OIDC_TOKEN as production runtime
# model-provider authority. For controlled non-production Gateway use, either
# server-owned key may be set; AI_GATEWAY_API_KEY has precedence over
# VERCEL_AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
# Set DSPY_API_BASE / DSPY_API_KEY only for an intentional whole-transport
# operator override. Explicit DSPy settings take precedence and disable the
# local-first route so the two configuration paths cannot be silently combined.
OPENAI_API_KEY=
